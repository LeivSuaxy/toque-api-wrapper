# ElToque
ELTOQUE_API_KEY=
ELTOQUE_BASE_URL=https://tasas.eltoque.com/v1/trmi

# Server
HTTP_ADDR=:8080
DATABASE_PATH=./data/toque.db

# Collector
FETCH_INTERVAL=5m
SAMPLE_SIZE=25
RETENTION=720h

# Superadmin
SUPERADMIN_USERNAME=admin

# Opción A (menos segura): contraseña en claro.
SUPERADMIN_PASSWORD=

# Opción B (recomendada): SHA-256 hex de la contraseña.
# Linux/macOS:
#   printf '%s' 'TU_PASSWORD' | sha256sum | cut -d' ' -f1
# macOS (alternativa):
#   printf '%s' 'TU_PASSWORD' | shasum -a 256 | cut -d' ' -f1
SUPERADMIN_PASSWORD_HASH=

# Security
SESSION_SECRET=
API_SECRET_PEPPER=
ADMIN_SESSION_TTL=12h
COOKIE_SECURE=true

# Rate limit
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Traceability
REQUEST_LOG_RETENTION=2160h
AUTH_FAILURE_RETENTION=720h

# Misc
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info
